Table "departments" {
  "dept_id" decimal(10) [pk]
  "dept_name" varchar(100)
  "location_id" decimal(10)
  "manager_id" decimal(10)
}

Table "locations" {
  "location_id" decimal(10) [pk]
  "city" varchar(100)
  "country_code" char(2)
}

Table "countries" {
  "country_code" char(2) [pk]
  "country_name" varchar(100)
}

Table "employees" {
  "emp_id" decimal(10) [pk]
  "emp_name" varchar(100)
  "department_id" decimal(10)
  "manager_id" decimal(10)
  "hire_date" date
  "location_id" decimal(10)
}

Table "projects" {
  "project_id" decimal(10) [pk]
  "project_name" varchar(200)
  "dept_id" decimal(10)
  "lead_emp_id" decimal(10)
  "backup_emp_id" decimal(10)
}

Table "assignments" {
  "assignment_id" decimal(10) [pk]
  "emp_id" decimal(10)
  "project_id" decimal(10)
  "start_date" date
}

Table "project_tasks" {
  "project_id" decimal(10)
  "task_id" decimal(10)
  "task_name" varchar(200)
  "assigned_emp_id" decimal(10)

  Indexes {
    (project_id, task_id) [pk]
  }
}

Table "task_hours" {
  "hour_id" decimal(10) [pk]
  "project_id" decimal(10)
  "task_id" decimal(10)
  "hours_worked" decimal(5,2)
}

Ref "fk_emp_dept":"departments"."dept_id" ?<? "employees"."department_id"

Ref "fk_dept_location":"locations"."location_id" ?<? "departments"."location_id"

Ref "fk_loc_country":"countries"."country_code" ?<? "locations"."country_code"

Ref "fk_emp_manager":"employees"."emp_id" ?<? "employees"."manager_id"

Ref "fk_dept_manager":"employees"."emp_id" ?<? "departments"."manager_id"

Ref:"departments"."dept_id" ?<? "projects"."dept_id"

Ref:"employees"."emp_id" ?<? "assignments"."emp_id"

Ref:"projects"."project_id" ?<? "assignments"."project_id"

Ref "fk_task_hours_project_task":"project_tasks".("project_id", "task_id") ?<? "task_hours".("project_id", "task_id")

Ref "fk_proj_lead_emp":"employees"."emp_id" ?<? "projects"."lead_emp_id" [delete: cascade]

Ref "fk_proj_backup_emp":"employees"."emp_id" ?<? "projects"."backup_emp_id" [delete: set null]

Ref "fk_task_assigned_emp":"employees"."emp_id" ?<? "project_tasks"."assigned_emp_id" [delete: cascade]

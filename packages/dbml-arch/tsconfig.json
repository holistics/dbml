{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@dbml/parse": [
        "../dbml-parse/src/index.ts"
      ],
      "@/*": [
        "../dbml-parse/src/*"
      ]
    }
  },
  "include": [
    "src",
    "__tests__"
  ]
}

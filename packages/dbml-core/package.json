{
  "$schema": "https://json.schemastore.org/package",
  "name": "@dbml/core",
  "version": "10.2.1-11.0.0-sqlingo.0.0",
  "description": "> TODO: description",
  "author": "Holistics <dev@holistics.io>",
  "license": "Apache-2.0",
  "homepage": "https://dbml.dbdiagram.io",
  "repository": "https://github.com/holistics/dbml/tree/master/packages/dbml-core",
  "keywords": [
    "dbml",
    "dbml-core"
  ],
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "files": [
    "lib",
    "types"
  ],
  "types": "./types/index.d.ts",
  "main": "./lib/index.cjs",
  "module": "./lib/index.mjs",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite build --watch",
    "test": "vitest run",
    "coverage": "echo \"Coverage is disabled - running normal tests without coverage\" && vitest run",
    "test:watch": "vitest watch",
    "bench": "vitest bench",
    "build:parser": "peggy --format es -o src/parse/sql/preprocessor/statement.js src/parse/sql/preprocessor/statement.pegjs && peggy --format es -o src/parse/schemarb/parser.js src/parse/schemarb/parser.pegjs",
    "build:lib": "vite build",
    "build": "rm -rf ./lib && npm run build:parser && npm run build:lib",
    "prepublish": "npm run build",
    "lint": "eslint $(git diff --relative --name-only --diff-filter=ACMRTUXB master -- . | grep -E '\\.(js|ts)$')",
    "lint:all": "eslint .",
    "lint:fix": "eslint --fix ."
  },
  "dependencies": {
    "@dbml/parse": "^10.2.1-11.0.0-sqlingo.0.0",
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1",
    "luxon": "^3.4.4",
    "pluralize": "^8.0.0",
    "sqlingo": "0.12.4"
  },
  "devDependencies": {
    "bluebird": "^3.5.5",
    "peggy": "^5.1.0"
  },
  "gitHead": "22950b397bac439d76aca6934b128cdf0b460521",
  "engines": {
    "node": ">=16"
  }
}

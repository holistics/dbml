Table "sample_table" {
  "status" varchar(20) [check: `"status" IN ('active', 'inactive', 'pending')`]
  "email" varchar(100) [check: `"email" LIKE '%@%.%'`]
  "user_type" varchar(20) [check: `NOT "user_type" IN ('banned', 'suspended')`]
}

Table "myschema"."sample_table" {
  "status" varchar(20)
  "email" varchar(100)
  "user_type" varchar(20)

  Checks {
    `status IN ('active', 'inactive', 'pending')` [name: 'chk_status']
    `email LIKE '%@%.%'` [name: 'chk_email']
    `NOT user_type IN ('banned', 'suspended')` [name: 'chk_user_type']
  }
}

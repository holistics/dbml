Table "orders" {
  "id" int [pk]
  "customer_id" int
  "status" varchar(20)
  "created_at" timestamp

  Indexes {
    (customer_id, created_at [desc]) [name: "orders_customer_recent"]
    (created_at [desc]) [name: "orders_created"]
    (status [desc], id) [unique, name: "orders_status_id"]
    (`(lower(status))` [desc]) [name: "orders_lower_status"]
  }
}

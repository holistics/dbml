Table "tbl" {
  "col1" longtext
  "data" json

  Indexes {
    `(SUBSTRING(col1, 1, 10))` [name: "idx1"]
    `(CAST(JSON_EXTRACT(data, _utf8mb4 '$') AS ARRAY<UBIGINT>))` [name: "idx2"]
    `(CAST(JSON_EXTRACT_SCALAR(data, '$.name') AS CHAR(30)))`
  }
}

Table "orders_json_2" {
  "id" int [pk, not null, increment]
  "reward" json
  "additional_info" json
  "created_at" timestamptz
  "updated_at" timestamptz

  Indexes {
    `(CAST(JSON_EXTRACT("additional_info", _utf8mb4 '$.order_codes') AS ARRAY<CHAR(17)>))` [name: "idx_order_codes"]
  }
}

Table "keywords" {

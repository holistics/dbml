Table "parent_table" {
  "id" int [pk]
  "column1" varchar(30)

  Checks {
    `LENGTH(column1) > 10`
  }

  Indexes {
    `COLUMN1(20)` [name: "parent_table_i1"]
  }
}

Table "child_table" {
  "id" uint [pk, increment]
  "id_parent" int
}

Table "actor" {
  "last_update" timestamptz [default: `CURRENT_TIMESTAMP()`]
  "birthday" datetime [default: `CURRENT_TIMESTAMP()`]
}

Table "boolean_table" {
  "c1" boolean
  "c2" boolean [default: true]
}

Table "default_table" {
  "c1" int [default: 42]
  "c2" int [default: `-42`]
  "c3" varchar(256) [default: `_utf8mb3 'xxx'`]
}

Table "ts_table" {
  "ts1" timestamptz [not null, default: `CURRENT_TIMESTAMP()`]
  "ts2" timestamptz [not null, default: `CURRENT_TIMESTAMP()`]

Table "customers" {
  "customer_id" int [pk, not null]
  "first_name" varchar(50)
  "last_name" varchar(50)
  "email" varchar(100)
  "registration_date" date

  Indexes {
    email [unique, name: "uq_customer_email"]
  }
}

Table "orders" {
  "order_id" int [pk, not null]
  "customer_id" int
  "order_date" date
  "total_amount" decimal(10,2)
}

Table "employees" {
  "employee_id" int [pk, not null]
  "first_name" varchar(50)
  "last_name" varchar(50)
  "hire_date" date
  "department" varchar(50)
}

Ref "fk_order_customer":"customers"."customer_id" ?<? "orders"."customer_id"

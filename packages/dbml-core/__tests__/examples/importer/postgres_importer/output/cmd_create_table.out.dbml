Table "a" {
  "id" int [unique, pk, default: 1]
  "name" varchar(255) [check: `"id" > -1`]
}

Table "b" {
  "id" uuid
  "name" varchar [not null, check: `name <> ''`]
  "email" varchar(55)

  Indexes {
    email [pk, name: "b_pk"]
    name [unique]
  }
}

Table "c" {
  "index" varchar(255) [unique]
  "phone" serial [increment]
  "time" timestamp
}

Table "circles" {
  "c" circle
}

Table "foo" {
  "bar" "text[]"
  "bar2" "int[]"
  "bar3" "int[][]"
  "bar4" "int[]"
  "bar5" "int[]"
  "bar6" "text[]"
  "bar7" "text[]"
  "bar8" "timetz(2)[]"
  "bar9" "time(1)[]"
  "bar10" "time(1)[]"
  "bar11" "time[]"
  "bar12" "timestamp(2)[][][]"
  "bar13" "varchar[]"
  "bar14" "varchar(25)[][][]"
  "bar15" "varchar[]"
}

Ref:"a"."id" ?<? "b"."id" [delete: no action]

Ref "c_time_constraint":"a"."name" ?<? "c"."time"

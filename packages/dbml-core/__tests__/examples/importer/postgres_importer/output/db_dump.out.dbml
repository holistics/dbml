Table "production"."billofmaterials" {
  "billofmaterialsid" int [pk, not null, default: `NEXTVAL(CAST('production.billofmaterials_billofmaterialsid_seq' AS REGCLASS))`]
  "productassemblyid" int
  "componentid" int [not null]
  "startdate" timestamp [not null, default: `CURRENT_TIMESTAMP()`]
  "enddate" timestamp
  "unitmeasurecode" char(3) [not null]
  "bomlevel" smallint [not null]
  "perassemblyqty" decimal(8,2) [not null, default: 1]
  "modifieddate" timestamp [not null, default: `CURRENT_TIMESTAMP()`]

  Checks {
    `(((productassemblyid IS NULL) AND (bomlevel = 0) AND (perassemblyqty = 1.00)) OR ((NOT productassemblyid IS NULL) AND (bomlevel >= 1)))` [name: 'CK_BillOfMaterials_BOMLevel']
    `((enddate > startdate) OR (enddate IS NULL))` [name: 'CK_BillOfMaterials_EndDate']
    `(perassemblyqty >= 1.00)` [name: 'CK_BillOfMaterials_PerAssemblyQty']
    `(productassemblyid <> componentid)` [name: 'CK_BillOfMaterials_ProductAssemblyID']
  }
  Note: 'Items required to make bicycles and bicycle subassemblies. It identifies the heirarchical relationship between a parent product and its components.'
}

Table "production"."culture" {
  "cultureid" char(6) [pk, not null]
  "name" Name [not null]
  "modifieddate" timestamp [not null, default: `CURRENT_TIMESTAMP()`]
  Note: 'Lookup table containing the languages in which some AdventureWorks data is stored.'
}

Table "production"."document" {
  "title" varchar(50) [not null]
  "owner" int [not null]
  "folderflag" Flag [not null, default: false]
  "filename" varchar(400) [not null]
  "fileextension" varchar(8)
  "revision" char(5) [not null]
  "changenumber" int [not null, default: 0]
  "status" smallint [not null]
  "documentsummary" text
  "document" varbinary
  "rowguid" uuid [not null, default: `public.uuid_generate_v1()`]
  "modifieddate" timestamp [not null, default: `CURRENT_TIMESTAMP()`]
  "documentnode" varchar [pk, not null, default: `CAST('/' AS VARCHAR)`]

  Checks {
    `((status >= 1) AND (status <= 3))` [name: 'CK_Document_Status']
  }

  Indexes {
    rowguid [unique, name: "document_rowguid_key"]
  }
  Note: 'Product maintenance documents.'
}

Table "production"."illustration" {
  "illustrationid" int [pk, not null, default: `NEXTVAL(CAST('production.illustration_illustrationid_seq' AS REGCLASS))`]
  "diagram" xml
  "modifieddate" timestamp [not null, default: `CURRENT_TIMESTAMP()`]
  Note: 'Bicycle assembly diagrams.'
}

Table "production"."location" {
  "locationid" int [pk, not null, default: `NEXTVAL(CAST('production.location_locationid_seq' AS REGCLASS))`]
  "name" Name [not null]
  "costrate" decimal [not null, default: 0]
  "availability" decimal(8,2) [not null, default: 0]
  "modifieddate" timestamp [not null, default: `CURRENT_TIMESTAMP()`]

  Checks {
    `(availability >= 0.00)` [name: 'CK_Location_Availability']
    `(costrate >= 0.00)` [name: 'CK_Location_CostRate']
  }
  Note: 'Product inventory and manufacturing locations.'
}

Table "production"."product" {
  "productid" int [pk, not null, default: `NEXTVAL(CAST('production.product_productid_seq' AS REGCLASS))`]
  "name" Name [not null]
  "productnumber" varchar(25) [not null]
  "makeflag" Flag [not null, default: true]
  "finishedgoodsflag" Flag [not null, default: true]
  "color" varchar(15)
  "safetystocklevel" smallint [not null]
  "reorderpoint" smallint [not null]
  "standardcost" decimal [not null]
  "listprice" decimal [not null]
  "size" varchar(5)
  "sizeunitmeasurecode" char(3)
  "weightunitmeasurecode" char(3)
  "weight" decimal(8,2)
  "daystomanufacture" int [not null]
  "productline" char(2)
  "class" char(2)
  "style" char(2)
  "productsubcategoryid" int
  "productmodelid" int
  "sellstartdate" timestamp [not null]
  "sellenddate" timestamp
  "discontinueddate" timestamp
  "rowguid" uuid [not null, default: `public.uuid_generate_v1()`]
  "modifieddate" timestamp [not null, default: `CURRENT_TIMESTAMP()`]

  Checks {
    `((UPPER(CAST((class) AS TEXT)) = ANY(ARRAY(CAST('L' AS TEXT), CAST('M' AS TEXT), CAST('H' AS TEXT)))) OR (class IS NULL))` [name: 'CK_Product_Class']
    `(daystomanufacture >= 0)` [name: 'CK_Product_DaysToManufacture']
    `(listprice >= 0.00)` [name: 'CK_Product_ListPrice']
    `((UPPER(CAST((productline) AS TEXT)) = ANY(ARRAY(CAST('S' AS TEXT), CAST('T' AS TEXT), CAST('M' AS TEXT), CAST('R' AS TEXT)))) OR (productline IS NULL))` [name: 'CK_Product_ProductLine']
    `(reorderpoint > 0)` [name: 'CK_Product_ReorderPoint']
    `(safetystocklevel > 0)` [name: 'CK_Product_SafetyStockLevel']
    `((sellenddate >= sellstartdate) OR (sellenddate IS NULL))` [name: 'CK_Product_SellEndDate']
    `(standardcost >= 0.00)` [name: 'CK_Product_StandardCost']
    `((UPPER(CAST((style) AS TEXT)) = ANY(ARRAY(CAST('W' AS TEXT), CAST('M' AS TEXT), CAST('U' AS TEXT)))) OR (style IS NULL))` [name: 'CK_Product_Style']
    `(weight > 0.00)` [name: 'CK_Product_Weight']
  }
  Note: 'Products sold or used in the manfacturing of sold products.'
}


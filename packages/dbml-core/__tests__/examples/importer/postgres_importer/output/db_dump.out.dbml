Table "person"."person" {
  "businessentityid" int [pk, not null]
  "persontype" char(2) [not null]
  "namestyle" NameStyle [not null, default: false]
  "title" varchar(8)
  "firstname" Name [not null]
  "middlename" Name
  "lastname" Name [not null]
  "suffix" varchar(10)
  "emailpromotion" int [not null, default: 0]
  "additionalcontactinfo" xml
  "demographics" xml
  "rowguid" uuid [not null, default: `public.uuid_generate_v1()`]
  "modifieddate" timestamp [not null, default: `CURRENT_TIMESTAMP()`]

  Checks {
    `((emailpromotion >= 0) AND (emailpromotion <= 2))` [name: 'CK_Person_EmailPromotion']
    `((persontype IS NULL) OR (UPPER(CAST((persontype) AS TEXT)) = ANY(ARRAY(CAST('SC' AS TEXT), CAST('VC' AS TEXT), CAST('IN' AS TEXT), CAST('EM' AS TEXT), CAST('SP' AS TEXT), CAST('GC' AS TEXT)))))` [name: 'CK_Person_PersonType']
  }
  Note: 'Human beings involved with AdventureWorks: employees, customer contacts, and vendor contacts.'
}


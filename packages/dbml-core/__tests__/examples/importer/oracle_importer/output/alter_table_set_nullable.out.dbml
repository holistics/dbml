Table "employees" {
  "emp_id" decimal(10) [not null]
  "emp_name" varchar(100) [not null]
  "email" varchar(100) [not null]
  "phone" varchar(20) [not null]
  "salary" decimal(10,2) [not null]
  "commission_pct" decimal(3,2) [not null]
  "hire_date" date [not null]
  "department_id" decimal(10) [not null]
  "manager_id" decimal(10) [not null]
  "status" varchar(20) [not null]
  "ssn" varchar(11) [not null]
  "badge_number" varchar(10) [not null]
  "title" varchar(100) [not null]
  "office_location" varchar(50) [not null]
}

Table "products" {
  "product_id" decimal(10) [not null]
  "product_name" varchar(200) [not null]
  "description" varchar(4000) [not null]
  "price" decimal(10,2) [not null]
  "category" varchar(50) [not null]
  "manufacturer" varchar(100) [not null]
  "sku" varchar(50) [not null]
  "weight" decimal(8,2) [not null]
}

Table "orders" {
  "order_id" decimal(10) [not null]
  "customer_id" decimal(10) [not null]
  "order_date" date [not null]
  "ship_date" date [not null]
  "total_amount" decimal(12,2) [not null]
  "tax_amount" decimal(10,2) [not null]
  "discount_amount" decimal(10,2) [not null]
}

Table "datatype_tests" {
  "col_number" decimal(10,2) [not null]
  "col_varchar2" varchar(100) [not null]
  "col_char" char(10) [not null]
  "col_date" date [not null]
  "col_timestamp" timestamp [not null]
  "col_clob" text [not null]
  "col_raw" RAW(100) [not null]
  "col_float" float [not null]
  "col_integer" int [not null]
  "col_nvarchar2" nvarchar(100) [not null]
  "col_nchar" nchar(10) [not null]
}

Table "complex_test" {
  "id" decimal(10) [pk]
  "code" varchar(20) [unique, not null]
  "name" varchar(100) [not null]
  "parent_id" decimal(10) [not null]
  "status" varchar(20) [not null]
}

Table "combo_test" {
  "col1" decimal(10) [not null]
  "col2" varchar(50) [not null]
}

Ref "fk_complex_parent":"complex_test"."id" <? "complex_test"."parent_id"

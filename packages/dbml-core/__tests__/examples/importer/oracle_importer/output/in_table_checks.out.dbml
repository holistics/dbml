Table "customers" {
  "cust_id" decimal(10)
  "cust_name" varchar(100)
  "email" varchar(100)
  "phone" varchar(20)

  Checks {
    `cust_id > 0`
  }
}

Table "inventory" {
  "item_id" decimal(10)
  "item_name" varchar(200)
  "price" decimal(10,2)
  "category" varchar(50)

  Checks {
    `price >= 0` [name: 'chk_price_pos']
  }
}

Table "shipments" {
  "ship_id" decimal(10)
  "customer_id" decimal(10)
  "ship_date" date
  "total_amount" decimal(12,2)

  Checks {
    `total_amount >= 0 AND NOT ship_date IS NULL` [name: 'chk_amount_date']
  }
}

Table "departments" {
  "dept_id" decimal(10)
  "dept_name" varchar(100)
  "manager_id" decimal(10)
  "budget" decimal(12,2)

  Checks {
    `budget >= 0`
  }
}

Table "suppliers" {
  "supp_id" decimal(10)
  "supp_name" varchar(100)
  "contact" varchar(100)
  "credit_limit" decimal(10,2)

  Checks {
    `credit_limit >= 0` [name: 'chk_credit_limit']
  }
}

Table "employees" {
  "emp_id" decimal(10)
  "emp_name" varchar(100)
  "email" varchar(100)
  "status" varchar(20)

  Checks {
    `status IN ('ACTIVE', 'INACTIVE', 'SUSPENDED')` [name: 'chk_status_values']
  }
}

Table "orders" {
  "order_id" decimal(10)
  "customer_id" decimal(10)
  "order_date" date
  "total_amount" decimal(12,2)
  "tax_amount" decimal(10,2)

  Checks {
    `total_amount >= tax_amount AND tax_amount >= 0` [name: 'chk_order_amounts']
  }
}

Table "contracts" {
  "contract_id" decimal(10)
  "start_date" date
  "end_date" date
  "amount" decimal(12,2)

  Checks {
    `end_date > start_date AND start_date >= CURRENT_TIMESTAMP()` [name: 'chk_date_range']
  }
}

Table "users" {
  "user_id" decimal(10)
  "username" varchar(50)
  "email" varchar(100)
  "ssn" varchar(11)

  Checks {
    `ssn LIKE '[0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9][0-9][0-9]'` [name: 'chk_ssn_format']
  }
}

Table "sales" {
  "sale_id" decimal(10)
  "sale_date" date
  "amount" decimal(12,2)
  "discount" decimal(10,2)

  Checks {
    `amount >= discount AND discount >= 0 AND sale_date >= CURRENT_TIMESTAMP()` [name: 'chk_sale_complex']
  }
}

Table "accounts" {
  "account_id" decimal(10)
  "account_number" varchar(20)
  "balance" decimal(12,2)
  "account_type" varchar(20)

  Checks {
    `REGEXP_LIKE(account_number, '^[0-9]{10}$')` [name: 'chk_acc_number']
  }
}

Table "reports" {
  "report_id" decimal(10)
  "report_name" varchar(100)
  "report_date" date
  "status" varchar(20)

  Checks {
    `status IN ('DRAFT', 'FINAL', 'ARCHIVED')` [name: 'chk_very_long_constraint_name_for_testing_parser_limits']
  }
}

Table "employees_sub" {
  "emp_id" decimal(10)
  "dept_id" decimal(10)
  "emp_name" varchar(100)
  "salary" decimal(10,2)

  Checks {
    `dept_id IN (SELECT dept_id FROM departments)` [name: 'chk_dept_exists']
  }
}

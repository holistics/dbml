Table "customers" {
  "cust_id" decimal(10)
  "cust_name" varchar(100) [not null]
  "email" varchar(100)
  "phone" varchar(20)
  "address" varchar(200)

  Indexes {
    phone [unique, name: "uk_cust_phone"]
  }
}

Table "inventory" {
  "item_id" decimal(10)
  "item_name" varchar(200) [not null]
  "price" decimal(10,2) [not null]
  "category" varchar(50)
  "sku" varchar(50)

  Indexes {
    sku [unique]
  }
}

Table "shipments" {
  "ship_id" decimal(10)
  "customer_id" decimal(10) [not null]
  "ship_date" date
  "total_amount" decimal(12,2)
  "tracking_number" varchar(50)
}

Table "datatype_tests" {
  "col_number" decimal(10,2)
  "col_varchar2" varchar(100)
  "col_char" char(10)
  "col_date" date
  "col_timestamp" timestamp
  "col_clob" text
  "col_raw" RAW(100)
  "col_float" float
  "col_integer" int
  "col_nvarchar2" nvarchar(100)
  "col_nchar" nchar(10)
}

Table "complex_test" {
  "id" decimal(10)
  "code" varchar(20)
  "name" varchar(100) [not null]
  "parent_id" decimal(10)
  "status" varchar(20)

  Indexes {
    (id, status) [unique, name: "uk_complex_id_status"]
  }
}

Table "combo_test" {
  "col1" decimal(10)
  "col2" varchar(50)
}

Ref "fk_complex_parent":"complex_test"."id" ?<? "complex_test"."parent_id"

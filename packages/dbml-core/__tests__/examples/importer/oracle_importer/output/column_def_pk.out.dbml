Table "customers" {
  "cust_id" decimal(10) [pk]
  "cust_name" varchar(100)
  "email" varchar(100)
  "phone" varchar(20)
}

Table "inventory" {
  "item_id" decimal(10) [pk]
  "item_name" varchar(200)
  "price" decimal(10,2)
  "category" varchar(50)
}

Table "shipments" {
  "ship_id" decimal(10) [pk]
  "customer_id" decimal(10)
  "ship_date" date
  "total_amount" decimal(12,2)
}

Table "departments" {
  "dept_id" decimal(10) [pk]
  "dept_name" varchar(100)
  "manager_id" decimal(10)
  "budget" decimal(12,2)
}

Table "suppliers" {
  "supp_id" decimal(10) [pk]
  "supp_name" varchar(100)
  "contact" varchar(100)
  "credit_limit" decimal(10,2)
}

Table "test_datatypes" {
  "col_number" decimal(10,2) [pk]
  "col_varchar2" varchar(100)
  "col_char" char(10)
  "col_date" date
  "col_timestamp" timestamp
  "col_clob" text
  "col_raw" RAW(100)
  "col_float" float
  "col_integer" int
  "col_nvarchar2" nvarchar(100)
  "col_nchar" nchar(10)
}

Table "test_basic" {
  "id" decimal(10) [pk]
  "value" decimal(10)
}

Table "test_named" {
  "code" decimal(10) [pk]
  "description" varchar(200)
}

Table "test_status" {
  "status_code" varchar(20) [pk]
  "status_desc" varchar(100)
}

Table "test_dates" {
  "event_date" date [pk]
  "event_desc" varchar(200)
}

Table "test_enable" {
  "level" decimal(2) [pk]
  "level_desc" varchar(50)
}

Table "test_disable" {
  "priority" decimal(2) [pk]
  "priority_desc" varchar(50)
}

Table "test_validate" {
  "amount" decimal(10,2) [pk]
  "amount_desc" varchar(100)
}

Table "test_novalidate" {
  "discount" decimal(10,2) [pk]
  "discount_desc" varchar(100)
}

Table "test_disable_novalidate" {
  "weight" decimal(8,2) [pk]
  "weight_desc" varchar(100)
}

Table "test_rely" {
  "code" decimal(10) [pk]
  "code_desc" varchar(50)
}

Table "test_norely" {
  "sequence" decimal(10) [pk]
  "sequence_desc" varchar(50)
}

Table "test_enable_rely" {
  "batch_id" decimal(10) [pk]
  "batch_desc" varchar(50)
}

Table "test_disable_norely" {
  "zone_id" decimal(5) [pk]
  "zone_desc" varchar(50)
}

Table "test_deferrable_deferred" {
  "order_id" decimal(10) [pk]
  "order_desc" varchar(100)
}

Table "test_deferrable_immediate" {
  "invoice_id" decimal(10) [pk]
  "invoice_desc" varchar(100)
}

Table "test_not_deferrable" {
  "ticket_id" decimal(10) [pk]
  "ticket_desc" varchar(100)
}

Table "test_datatypes_inline" {
  "col_number" decimal(10,2) [pk]
  "col_varchar2" varchar(100)
  "col_char" char(10) [pk]
  "col_date" date [pk]
  "col_timestamp" timestamp [pk]
  "col_clob" text [pk]
  "col_raw" RAW(100) [pk]
  "col_float" float [pk]
  "col_integer" int [pk]
  "col_nvarchar2" nvarchar(100) [pk]
  "col_nchar" nchar(10) [pk]
}

Table "test_long_name" {
  "identifier" decimal(10) [pk]
  "record_code" varchar(20)
}

Table "test_complex" {
  "score" decimal(3) [pk]
  "rating" varchar(20) [pk]
}

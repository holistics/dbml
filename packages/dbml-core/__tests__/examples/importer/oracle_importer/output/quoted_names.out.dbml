Table " aba " {
  "birthday" text
  "date of birth" text

  Indexes {
    date of birth [pk, name: " primary key bd "]
  }
}

Table "silver  users" {
  "children  " int [check: `"children  " > 0`]
  "date of birth" text

  Checks {
    `NOT "date of birth" IS NULL` [name: 'silver dob']
  }

  Indexes {
    (date of birth, `' a aaa '`) [name: "index on silver"]
  }
}

Ref " foreign key bd ":"silver  users"."date of birth" ?<? " aba "."date of birth"

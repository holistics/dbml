Table "customers" {
  "cust_id" decimal(10) [check: `cust_id > 0`]
  "cust_name" varchar(100) [check: `LENGTH(cust_name) <= 100`]
  "email" varchar(100) [check: `email LIKE '%@%.%'`]
  "phone" varchar(20) [check: `LENGTH(phone) >= 10`]
  "address" varchar(200) [check: `NOT address IS NULL`]
  "status" varchar(20) [check: `status IN ('ACTIVE', 'INACTIVE')`]
  "reg_date" date [check: `reg_date >= STR_TO_DATE('2000-01-01', '%Y-%m-%d')`]
  "last_login" timestamp [check: `last_login <= SYSTIMESTAMP()`, check: `last_login >= SYSTIMESTAMP()`]
  "last_login_2" timestamp [check: `last_login_2 <= SYSTIMESTAMP()`, check: `last_login_2 >= SYSTIMESTAMP()`]
  "last_login_3" timestamp [check: `last_login_3 <= SYSTIMESTAMP()`, check: `last_login_3 >= SYSTIMESTAMP()`]
}

Table "inventory" {
  "item_id" decimal(10) [check: `item_id > 0`]
  "item_name" varchar(200) [check: `NOT item_name IS NULL`]
  "price" decimal(10,2) [check: `price >= 0`]
  "category" varchar(50) [check: `category IN ('ELECTRONICS', 'CLOTHING', 'BOOKS')`]
  "sku" varchar(50) [check: `LENGTH(sku) <= 50`]
  "weight" decimal(8,2) [check: `weight > 0`]
  "stock_level" decimal(10) [check: `stock_level >= 0`]
  "reorder_level" decimal(10) [check: `reorder_level >= 0`]
}

Table "shipments" {
  "ship_id" decimal(10) [check: `ship_id > 0`]
  "customer_id" decimal(10) [check: `customer_id > 0`]
  "ship_date" date [check: `ship_date >= DATE_TRUNC('DD', CURRENT_TIMESTAMP())`]
  "total_amount" decimal(12,2) [check: `total_amount >= 0`]
  "tracking_number" varchar(50) [check: `LENGTH(tracking_number) <= 50`]
  "carrier" varchar(100) [check: `NOT carrier IS NULL`]
  "priority" decimal(2) [check: `priority BETWEEN 1 AND 5`]
  "notes" varchar(4000) [check: `LENGTH(notes) <= 4000`]
}

Table "departments" {
  "dept_id" decimal(10) [check: `dept_id > 0`]
  "dept_name" varchar(100) [check: `NOT dept_name IS NULL`]
  "manager_id" decimal(10) [check: `manager_id > 0`]
  "budget" decimal(12,2) [check: `budget >= 0`]
  "location" varchar(50) [check: `NOT location IS NULL`]
  "established_date" date [check: `established_date <= CURRENT_TIMESTAMP()`]
}

Table "suppliers" {
  "supp_id" decimal(10) [check: `supp_id > 0`]
  "supp_name" varchar(100) [check: `NOT supp_name IS NULL`]
  "contact" varchar(100) [check: `LENGTH(contact) <= 100`]
  "ssn" varchar(11) [check: `ssn LIKE '___-__-____'`]
  "badge_number" varchar(10) [check: `LENGTH(badge_number) <= 10`]
  "credit_limit" decimal(10,2) [check: `credit_limit >= 0`]
}

Table "test_datatypes" {
  "col_number" decimal(10,2) [check: `col_number >= 0`]
  "col_varchar2" varchar(100) [check: `LENGTH(col_varchar2) <= 100`]
  "col_char" char(10) [check: `LENGTH(col_char) = 10`]
  "col_date" date [check: `col_date >= STR_TO_DATE('2000-01-01', '%Y-%m-%d')`]
  "col_timestamp" timestamp [check: `col_timestamp <= SYSTIMESTAMP()`]
  "col_clob" text [check: `NOT col_clob IS NULL`]
  "col_raw" RAW(100) [check: `LENGTH(col_raw) <= 100`]
  "col_float" float [check: `col_float >= 0`]
  "col_integer" int [check: `col_integer >= 0`]
  "col_nvarchar2" nvarchar(100) [check: `LENGTH(col_nvarchar2) <= 100`]
  "col_nchar" nchar(10) [check: `LENGTH(col_nchar) = 10`]
}

Table "test_basic" {
  "id" decimal(10) [check: `id > 0`]
  "value" decimal(10) [check: `value BETWEEN 1 AND 1000`]
}

Table "test_status" {
  "status" varchar(20) [check: `status IN ('OPEN', 'CLOSED', 'PENDING')`]
  "code" varchar(10) [check: `LENGTH(code) <= 10`]
}

Table "test_not_null" {
  "name" varchar(100) [check: `NOT name IS NULL`]
  "description" varchar(200) [check: `LENGTH(description) <= 200`]
}

Table "test_dates" {
  "event_date" date [check: `event_date >= CURRENT_TIMESTAMP()`]
  "end_date" date [check: `end_date > CURRENT_TIMESTAMP()`]
}

Table "test_compound" {
  "quantity" decimal(10) [check: `quantity >= 0`]
  "price" decimal(10,2) [check: `quantity * price >= 0`]
}

Table "test_pattern" {
  "email" varchar(100) [check: `email LIKE '%@%.%'`]
  "phone" varchar(20) [check: `phone LIKE '[0-9]%'`]
}

Table "test_multi_condition" {
  "score" decimal(3) [check: `score BETWEEN 0 AND 100`]
  "grade" char(1) [check: `grade IN ('A', 'B', 'C', 'D', 'F') AND score > 0`]
}

Table "test_enable" {
  "level" decimal(2) [check: `level BETWEEN 1 AND 10`]
  "rating" decimal(2) [check: `rating >= 0`]
}

Table "test_disable" {
  "priority" decimal(2) [check: `priority BETWEEN 1 AND 5`]
  "rank" decimal(2) [check: `rank >= 0`]
}

Table "test_validate" {
  "amount" decimal(10,2) [check: `amount >= 0`]
  "tax" decimal(10,2) [check: `tax >= 0`]
}

Table "test_novalidate" {
  "discount" decimal(10,2) [check: `discount >= 0`]
  "margin" decimal(10,2) [check: `margin >= 0`]
}

Table "test_disable_novalidate" {
  "weight" decimal(8,2) [check: `weight > 0`]
  "volume" decimal(8,2) [check: `volume > 0`]
}

Table "test_rely" {
  "code" decimal(10) [check: `code > 0`]
  "ref_id" decimal(10) [check: `ref_id > 0`]
}

Table "test_norely" {
  "sequence" decimal(10) [check: `sequence > 0`]
  "counter" decimal(10) [check: `counter >= 0`]
}

Table "test_enable_rely" {
  "batch_id" decimal(10) [check: `batch_id > 0`]
  "lot_number" varchar(20) [check: `LENGTH(lot_number) <= 20`]
}

Table "test_disable_norely" {
  "zone_id" decimal(5) [check: `zone_id > 0`]
  "area_code" varchar(10) [check: `LENGTH(area_code) <= 10`]
}

Table "test_deferrable_deferred" {
  "order_id" decimal(10) [check: `order_id > 0`]
  "line_item" decimal(5) [check: `line_item > 0`]
}

Table "test_deferrable_immediate" {
  "invoice_id" decimal(10) [check: `invoice_id > 0`]
  "payment_status" varchar(20) [check: `payment_status IN ('PAID', 'PENDING')`]
}

Table "test_not_deferrable" {
  "ticket_id" decimal(10) [check: `ticket_id > 0`]
  "issue_date" date [check: `issue_date <= CURRENT_TIMESTAMP()`]
}

Table "test_datatypes_inline" {
  "col_number" decimal(10,2) [check: `col_number >= 0`]
  "col_varchar2" varchar(100) [check: `LENGTH(col_varchar2) <= 100`]
  "col_char" char(10) [check: `LENGTH(col_char) = 10`]
  "col_date" date [check: `col_date >= STR_TO_DATE('2000-01-01', '%Y-%m-%d')`]
  "col_timestamp" timestamp [check: `col_timestamp <= SYSTIMESTAMP()`]
  "col_clob" text [check: `NOT col_clob IS NULL`]
  "col_raw" RAW(100) [check: `LENGTH(col_raw) <= 100`]
  "col_float" float [check: `col_float >= 0`]
  "col_integer" int [check: `col_integer >= 0`]
  "col_nvarchar2" nvarchar(100) [check: `LENGTH(col_nvarchar2) <= 100`]
  "col_nchar" nchar(10) [check: `LENGTH(col_nchar) = 10`]
}

Table "test_complex" {
  "score" decimal(3) [check: `score >= 0 AND score % 2 = 0`]
  "rating" varchar(20) [check: `rating IN ('HIGH', 'MEDIUM', 'LOW') AND LENGTH(rating) > 3`]
}

Table "test_pattern_match" {
  "zip_code" varchar(10) [check: `REGEXP_LIKE(zip_code, '^[0-9]{5}(-[0-9]{4})?$')`]
  "serial_number" varchar(20) [check: `REGEXP_LIKE(serial_number, '^[A-Z0-9]+$')`]
}

Table "test_subquery" {
  "dept_id" decimal(10) [check: `dept_id IN (SELECT dept_id FROM departments)`]
  "emp_count" decimal(5) [check: `emp_count >= 0`]
}

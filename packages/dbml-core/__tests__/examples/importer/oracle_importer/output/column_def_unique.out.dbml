Table "customers" {
  "cust_id" decimal(10) [unique]
  "cust_name" varchar(100) [unique]
  "email" varchar(100) [unique]
  "phone" varchar(20) [unique]
}

Table "inventory" {
  "item_id" decimal(10) [unique]
  "item_name" varchar(200) [unique]
  "price" decimal(10,2)
  "sku" varchar(50) [unique]
}

Table "shipments" {
  "ship_id" decimal(10) [unique]
  "customer_id" decimal(10)
  "ship_date" date [unique]
  "tracking_number" varchar(50) [unique]
}

Table "departments" {
  "dept_id" decimal(10) [unique]
  "dept_name" varchar(100) [unique]
  "manager_id" decimal(10) [unique]
  "budget" decimal(12,2)
}

Table "suppliers" {
  "supp_id" decimal(10) [unique]
  "supp_name" varchar(100) [unique]
  "contact" varchar(100) [unique]
  "ssn" varchar(11) [unique]
}

Table "test_datatypes" {
  "col_number" decimal(10,2) [unique]
  "col_varchar2" varchar(100) [unique]
  "col_char" char(10) [unique]
  "col_date" date [unique]
  "col_timestamp" timestamp [unique]
  "col_clob" text [unique]
  "col_raw" RAW(100) [unique]
  "col_float" float [unique]
  "col_integer" int [unique]
  "col_nvarchar2" nvarchar(100) [unique]
  "col_nchar" nchar(10) [unique]
}

Table "test_basic" {
  "id" decimal(10) [unique]
  "value" decimal(10) [unique]
}

Table "test_named" {
  "code" varchar(20) [unique]
  "ref_id" decimal(10) [unique]
}

Table "test_status" {
  "status" varchar(20) [unique]
  "status_code" varchar(10) [unique]
}

Table "test_dates" {
  "event_date" date [unique]
  "end_date" date [unique]
}

Table "test_enable" {
  "level" decimal(2) [unique]
  "rating" decimal(2) [unique]
}

Table "test_disable" {
  "priority" decimal(2) [unique]
  "rank" decimal(2) [unique]
}

Table "test_validate" {
  "amount" decimal(10,2) [unique]
  "tax" decimal(10,2) [unique]
}

Table "test_novalidate" {
  "discount" decimal(10,2) [unique]
  "margin" decimal(10,2) [unique]
}

Table "test_disable_novalidate" {
  "weight" decimal(8,2) [unique]
  "volume" decimal(8,2) [unique]
}

Table "test_rely" {
  "code" decimal(10) [unique]
  "ref_id" decimal(10) [unique]
}

Table "test_norely" {
  "sequence" decimal(10) [unique]
  "counter" decimal(10) [unique]
}

Table "test_enable_rely" {
  "batch_id" decimal(10) [unique]
  "lot_number" varchar(20) [unique]
}

Table "test_disable_norely" {
  "zone_id" decimal(5) [unique]
  "area_code" varchar(10) [unique]
}

Table "test_deferrable_deferred" {
  "order_id" decimal(10) [unique]
  "line_item" decimal(5) [unique]
}

Table "test_deferrable_immediate" {
  "invoice_id" decimal(10) [unique]
  "payment_status" varchar(20) [unique]
}

Table "test_not_deferrable" {
  "ticket_id" decimal(10) [unique]
  "issue_date" date [unique]
}

Table "test_datatypes_inline" {
  "col_number" decimal(10,2) [unique]
  "col_varchar2" varchar(100) [unique]
  "col_char" char(10) [unique]
  "col_date" date [unique]
  "col_timestamp" timestamp [unique]
  "col_clob" text [unique]
  "col_raw" RAW(100) [unique]
  "col_float" float [unique]
  "col_integer" int [unique]
  "col_nvarchar2" nvarchar(100) [unique]
  "col_nchar" nchar(10) [unique]
}

Table "test_long_name" {
  "identifier" decimal(10) [unique]
  "record_code" varchar(20) [unique]
}

Table "test_complex" {
  "score" decimal(3) [unique]
  "rating" varchar(20) [unique]
}

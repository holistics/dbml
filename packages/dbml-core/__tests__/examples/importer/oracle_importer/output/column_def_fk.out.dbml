Ref:"suppliers"."supp_id" ?<? "test_disable_norely"."supp_id"

Ref:"departments"."dept_id" ?<? "test_deferrable_deferred"."dept_id"

Ref:"customers"."cust_id" ?<? "test_deferrable_deferred"."cust_id"

Ref:"inventory"."item_id" ?<? "test_deferrable_immediate"."item_id"

Ref:"suppliers"."supp_id" ?<? "test_deferrable_immediate"."supp_id"

Ref:"departments"."dept_id" ?<? "test_not_deferrable"."dept_id"

Ref:"customers"."cust_id" ?<? "test_not_deferrable"."cust_id"

Ref:"test_datatypes"."col_number" ?<? "test_datatypes_fk"."col_number"

Ref:"test_datatypes"."col_varchar2" ?<? "test_datatypes_fk"."col_varchar2"

Ref:"employees_self"."emp_id" ?<? "employees_self"."manager_id"

Ref:"departments"."dept_id" ?<? "employees_self"."dept_id"

Ref:"inventory"."item_id" ?<? "order_details"."item_id"

Ref:"customers"."cust_id" ?<? "order_details"."cust_id"


Ref:"suppliers"."supp_id" ?<? "test_cascade"."supp_id" [delete: cascade]

Ref:"departments"."dept_id" ?<? "test_set_null"."dept_id" [delete: set null]

Ref:"customers"."cust_id" ?<? "test_set_null"."cust_id" [delete: set null]

Table "departments" {
  "dept_id" decimal(10)
  "dept_name" varchar(100)

  Indexes {
    dept_id [pk, name: "pk_dept_id"]
  }
}

Table "suppliers" {
  "supp_id" decimal(10)
  "supp_name" varchar(100)

  Indexes {
    supp_id [pk, name: "pk_supp_id"]
  }
}

Table "customers" {
  "cust_id" decimal(10)
  "cust_name" varchar(100)

  Indexes {
    cust_id [pk, name: "pk_cust_id"]
  }
}

Table "inventory" {
  "item_id" decimal(10)
  "item_name" varchar(200)

  Indexes {
    item_id [pk, name: "pk_item_id"]
  }
}

Table "complex_test" {
  "id" decimal(10)
  "code" varchar(20)

  Indexes {
    id [pk, name: "pk_complex_id"]
  }
}

Table "test_datatypes" {
  "col_number" decimal(10,2)
  "col_varchar2" varchar(100)

  Indexes {
    col_number [pk, name: "pk_datatype_number"]
  }
}

Table "employees" {
  "emp_id" decimal(10)
  "emp_name" varchar(100)
  "dept_id" decimal(10)
  "manager_id" decimal(10)
}

Table "orders" {
  "order_id" decimal(10)
  "customer_id" decimal(10)
  "tracking_number" varchar(50)
}

Table "shipments" {
  "ship_id" decimal(10)
  "customer_id" decimal(10) [not null]
  "tracking_number" varchar(50) [pk]
}

Table "complex_child" {
  "child_id" decimal(10)
  "parent_id" decimal(10)
  "parent_code" varchar(20)
}

Table "test_enable" {
  "id" decimal(10)
  "dept_id" decimal(10)
  "supp_id" decimal(10)
}

Table "test_disable" {
  "id" decimal(10)
  "dept_id" decimal(10)
  "cust_id" decimal(10)
}

Table "test_validate" {
  "id" decimal(10)
  "item_id" decimal(10)
  "supp_id" decimal(10)
}

Table "test_novalidate" {
  "id" decimal(10)
  "dept_id" decimal(10)
  "cust_id" decimal(10)
}

Table "test_disable_novalidate" {
  "id" decimal(10)
  "item_id" decimal(10)
  "supp_id" decimal(10)
}

Table "test_rely" {
  "id" decimal(10)
  "dept_id" decimal(10)
  "cust_id" decimal(10)
}

Table "test_norely" {
  "id" decimal(10)
  "item_id" decimal(10)
  "supp_id" decimal(10)
}

Table "test_enable_rely" {
  "id" decimal(10)
  "dept_id" decimal(10)
  "cust_id" decimal(10)
}

Table "test_disable_norely" {
  "id" decimal(10)
  "item_id" decimal(10)
  "supp_id" decimal(10)
}

Table "test_deferrable_deferred" {
  "id" decimal(10)
  "dept_id" decimal(10)
  "cust_id" decimal(10)
}

Table "test_deferrable_immediate" {
  "id" decimal(10)
  "item_id" decimal(10)
  "supp_id" decimal(10)
}

Table "test_not_deferrable" {
  "id" decimal(10)
  "dept_id" decimal(10)
  "cust_id" decimal(10)
}

Table "test_datatypes_fk" {
  "id" decimal(10)
  "col_number" decimal(10,2)
  "col_varchar2" varchar(100)
  "col_char" char(10)
  "col_date" date
  "col_timestamp" timestamp
  "col_clob" text
  "col_raw" RAW(100)
  "col_float" float
  "col_integer" int
  "col_nvarchar2" nvarchar(100)
  "col_nchar" nchar(10)
}

Table "employees_self" {
  "emp_id" decimal(10)
  "manager_id" decimal(10)
  "dept_id" decimal(10)
}

Table "order_details" {
  "order_id" decimal(10)
  "item_id" decimal(10)
  "cust_id" decimal(10)
}

Table "test_cascade" {
  "id" decimal(10)
  "dept_id" decimal(10)
  "supp_id" decimal(10)
}

Table "test_set_null" {
  "id" decimal(10)
  "dept_id" decimal(10)
  "cust_id" decimal(10)
}

Ref:"departments"."dept_id" ?<? "employees"."dept_id"

Ref:"employees"."emp_id" ?<? "employees"."manager_id"

Ref:"customers"."cust_id" ?<? "orders"."customer_id"

Ref:"shipments"."tracking_number" ?<? "orders"."tracking_number"

Ref:"customers"."cust_id" <? "shipments"."customer_id"


Table "customers" {
  "cust_id" decimal(10)
  "cust_name" varchar(100)
  "email" varchar(100)
  "phone" varchar(20)
  "status" varchar(20)
  "reg_date" date
  "region" varchar(50)
  "credit_limit" decimal(10,2)

  Indexes {
    cust_id [name: "idx_cust_id"]
    email [unique, name: "idx_cust_email"]
    status [name: "idx_cust_status"]
    `UPPER(cust_name)` [name: "idx_cust_name_upper"]
    `LOWER(email)` [unique, name: "idx_cust_email_lower"]
    cust_id [name: "idx_very_long_index_name_for_testing_parser_limits"]
    cust_id [name: "idx_cust_id_bitmap"]
    `CAST(reg_date AS TEXT) || cust_name` [name: "idx_cust_complex"]
  }
}

Table "inventory" {
  "item_id" decimal(10)
  "item_name" varchar(200)
  "price" decimal(10,2)
  "category" varchar(50)
  "sku" varchar(50)
  "stock_level" decimal(10)
  "warehouse_id" decimal(10)
  "supplier_id" decimal(10)

  Indexes {
    (item_name, price) [name: "idx_inv_item_price"]
    (category, stock_level) [name: "idx_inv_category_stock"]
    (`UPPER(item_name)`, `price * 1.1`) [name: "idx_inv_name_price"]
    `ORA_HASH(item_name)` [name: "idx_inv_hash_like"]
  }
}

Table "shipments" {
  "ship_id" decimal(10)
  "customer_id" decimal(10)
  "ship_date" date
  "total_amount" decimal(12,2)
  "tracking_number" varchar(50)
  "carrier" varchar(100)
  "priority" decimal(2)

  Indexes {
    (customer_id, ship_date) [unique, name: "idx_ship_cust_date"]
    customer_id [name: "idx_ship_nullable"]
  }
}

Table "departments" {
  "dept_id" decimal(10)
  "dept_name" varchar(100)
  "manager_id" decimal(10)
  "location" varchar(50)
}

Table "suppliers" {
  "supp_id" decimal(10)
  "supp_name" varchar(100)
  "contact" varchar(100)
  "city" varchar(50)
}

Table "test_datatypes" {
  "col_number" decimal(10,2)
  "col_varchar2" varchar(100)
  "col_char" char(10)
  "col_date" date
  "col_timestamp" timestamp
  "col_clob" text
  "col_raw" RAW(100)
  "col_float" float
  "col_integer" int
  "col_nvarchar2" nvarchar(100)
  "col_nchar" nchar(10)

  Indexes {
    (col_number, col_varchar2, col_date) [name: "idx_dt_mixed"]
  }
}

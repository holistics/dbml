Table "customers" {
  "cust_id" decimal(10) [default: 0]
  "cust_name" varchar(100) [default: 'Unknown']
  "email" varchar(100) [default: 'noemail@example.com']
  "phone" varchar(20) [default: 'N/A']
  "address" varchar(200) [default: 'Unknown Address']
  "status" varchar(20) [default: 'ACTIVE']
  "reg_date" date [default: `CURRENT_TIMESTAMP()`]
  "last_login" timestamp [default: `SYSTIMESTAMP()`]
}

Table "inventory" {
  "item_id" decimal(10) [default: 1]
  "item_name" varchar(200) [default: 'Item']
  "price" decimal(10,2) [default: 0]
  "category" varchar(50) [default: 'Misc']
  "sku" varchar(50) [default: 'SKU000']
  "weight" decimal(8,2) [default: 0]
  "stock_level" decimal(10) [default: 0]
  "reorder_level" decimal(10) [default: 10]
}

Table "shipments" {
  "ship_id" decimal(10) [default: `test_seq.NEXTVAL`]
  "customer_id" decimal(10) [default: 1]
  "ship_date" date [default: `CURRENT_TIMESTAMP()`]
  "total_amount" decimal(12,2) [default: 0]
  "tracking_number" varchar(50) [default: `SYS_GUID()`]
  "carrier" varchar(100) [default: 'UPS']
  "priority" decimal(2) [default: 1]
  "notes" varchar(4000) [default: 'No notes']
}

Table "departments" {
  "dept_id" decimal(10) [default: 100]
  "dept_name" varchar(100) [default: 'General']
  "manager_id" decimal(10) [default: 0]
  "budget" decimal(12,2) [default: 10000]
  "location" varchar(50) [default: 'HQ']
  "established_date" date [default: `CURRENT_TIMESTAMP()`]
}

Table "suppliers" {
  "supp_id" decimal(10) [default: 500]
  "supp_name" varchar(100) [default: 'Supplier']
  "contact" varchar(100) [default: 'Contact']
  "ssn" varchar(11) [default: '000-00-0000']
  "badge_number" varchar(10) [default: 'BADGE000']
  "credit_limit" decimal(10,2) [default: 5000]
}

Table "test_datatypes" {
  "col_number" decimal(10,2) [default: 42]
  "col_varchar2" varchar(100) [default: 'Default Text']
  "col_char" char(10) [default: 'CHARDEF   ']
  "col_date" date [default: `CURRENT_TIMESTAMP()`]
  "col_timestamp" timestamp [default: `SYSTIMESTAMP()`]
  "col_clob" text [default: `EMPTY_CLOB()`]
  "col_raw" RAW(100) [default: `HEXTORAW('00')`]
  "col_float" float [default: 3.14]
  "col_integer" int [default: 100]
  "col_nvarchar2" nvarchar(100) [default: `N'Default National'`]
  "col_nchar" nchar(10) [default: `N'NCHARDEF  '`]
}

Table "test_basic_num" {
  "id" decimal(10) [default: 0]
  "value" decimal(10) [default: 100]
}

Table "test_basic_varchar" {
  "name" varchar(100) [default: 'Unknown']
  "code" varchar(10) [default: 'CODE']
}

Table "test_basic_date" {
  "event_date" date [default: `CURRENT_TIMESTAMP()`]
  "end_date" date [default: `CURRENT_TIMESTAMP() + 1`]
}

Table "test_expr_sysdate" {
  "created_at" date [default: `CURRENT_TIMESTAMP()`]
  "updated_at" date [default: `CURRENT_TIMESTAMP()`]
}

Table "test_expr_user" {
  "created_by" varchar(30) [default: `USER`]
  "modified_by" varchar(30) [default: `USER`]
}

Table "test_expr_guid" {
  "unique_id" varchar(32) [default: `SYS_GUID()`]
  "session_id" varchar(32) [default: `SYS_GUID()`]
}

Table "test_expr_seq" {
  "seq_id" decimal(10) [default: `test_seq.NEXTVAL`]
  "auto_id" decimal(10) [default: `test_seq.NEXTVAL`]
}

Table "test_expr_arith" {
  "base_value" decimal(10) [default: 1000]
  "calc_value" decimal(10) [default: `1000 + 500`]
}

Table "test_on_null_basic" {
  "email" varchar(100) [default: 'noemail@example.com']
  "phone" varchar(20) [default: 'N/A']
}

Table "test_on_null_num" {
  "quantity" decimal(10) [default: 0]
  "discount" decimal(5,2) [default: 0]
}

Table "test_on_null_date" {
  "start_date" date [default: `CURRENT_TIMESTAMP()`]
  "end_date" date [default: `CURRENT_TIMESTAMP() + 7`]
}

Table "test_default_not_null" {
  "status" varchar(20) [not null, default: 'ACTIVE']
  "priority" decimal(2) [not null, default: 1]
}

Table "test_on_null_not_null" {
  "name" varchar(100) [not null, default: 'Unknown']
  "code" varchar(10) [not null, default: 'CODE']
}

Table "test_nn_enable" {
  "level" decimal(2) [not null, default: 1]
  "rating" decimal(2) [not null, default: 5]
}

Table "test_nn_disable" {
  "rank" decimal(2) [not null, default: 10]
  "score" decimal(3) [not null, default: 0]
}

Table "test_nn_validate" {
  "amount" decimal(10,2) [not null, default: 0]
  "tax" decimal(10,2) [not null, default: 0]
}

Table "test_nn_novalidate" {
  "discount" decimal(5,2) [not null, default: 0]
  "margin" decimal(5,2) [not null, default: 0.1]
}

Table "test_nn_disable_noval" {
  "weight" decimal(8,2) [not null, default: 0]
  "volume" decimal(8,2) [not null, default: 0]
}

Table "test_nn_rely" {
  "code" decimal(10) [not null, default: 100]
  "ref_id" decimal(10) [not null, default: 200]
}

Table "test_nn_norely" {
  "sequence" decimal(10) [not null, default: 1]
  "counter" decimal(10) [not null, default: 0]
}

Table "test_nn_enable_rely" {
  "batch_id" decimal(10) [not null, default: 500]
  "lot_number" varchar(20) [not null, default: 'LOT']
}

Table "test_nn_disable_norely" {
  "zone_id" decimal(5) [not null, default: 1]
  "area_code" varchar(10) [not null, default: 'AREA']
}

Table "test_nn_defer_deferred" {
  "order_id" decimal(10) [not null, default: 1000]
  "line_item" decimal(5) [not null, default: 1]
}

Table "test_nn_defer_immediate" {
  "invoice_id" decimal(10) [not null, default: 2000]
  "payment_status" varchar(20) [not null, default: 'PENDING']
}

Table "test_nn_not_defer" {
  "ticket_id" decimal(10) [not null, default: 3000]
  "issue_date" date [not null, default: `CURRENT_TIMESTAMP()`]
}

Table "test_datatypes_inline" {
  "col_number" decimal(10,2) [default: 0]
  "col_varchar2" varchar(100) [default: 'Text']
  "col_char" char(10) [default: 'CHAR      ']
  "col_date" date [default: `CURRENT_TIMESTAMP()`]
  "col_timestamp" timestamp [default: `SYSTIMESTAMP()`]
  "col_clob" text [default: 'CLOB Default']
  "col_raw" RAW(100) [default: `HEXTORAW('0000')`]
  "col_float" float [default: 1.23]
  "col_integer" int [default: 42]
  "col_nvarchar2" nvarchar(100) [default: `N'National Text'`]
  "col_nchar" nchar(10) [default: `N'NCHAR     '`]
}

Table "test_complex_expr" {
  "full_name" varchar(200) [default: `USER || '_USER'`]
  "calc_field" decimal(10) [default: `100 * 2`]
}

Table "test_long_default" {
  "description" varchar(4000) [default: 'This is a very long default value for testing purposes, exceeding typical lengths to check parser limits and storage implications in Oracle SQL']
  "comments" varchar(4000) [default: 'Another long default string to test maximum lengths and handling in table creation statements']
}

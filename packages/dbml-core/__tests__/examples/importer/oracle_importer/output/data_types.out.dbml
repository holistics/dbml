Table "data_types" {
  "c1_char" char(10)
  "c2_varchar2" varchar(50)
  "c3_varchar" varchar(50)
  "c4_nchar" nchar(20)
  "c5_nvarchar2" nvarchar(100)
  "c6_number" decimal(10,2)
  "c7_long" bigint
  "c8_date" date
  "c9_binary_float" float
  "c10_binary_double" double
  "c11_timestamp" timestamp(6)
  "c12_timestamp_with_tz" timestamptz(6)
  "c13_timestamp_with_local_tz" timestampltz(6)
  "c14_interval_ytm" "INTERVAL YEAR (2) TO MONTH"
  "c15_interval_dts" "INTERVAL DAY (2) TO SECOND (6)"
  "c16_raw" RAW(1000)
  "c17_long_raw" "LONG RAW"
  "c18_rowid" ROWID
  "c19_urowid" UROWID(4000)
  "c20_clob" text
  "c21_nclob" NCLOB
  "c22_blob" varbinary
  "c23_bfile" BFILE
  "c24_xmltype" XMLTYPE
}

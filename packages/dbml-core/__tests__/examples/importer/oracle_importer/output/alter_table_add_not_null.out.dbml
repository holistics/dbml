Table "customers" {
  "cust_id" decimal(10)
  "cust_name" varchar(100)
  "email" varchar(100)
  "phone" varchar(20)
}

Table "inventory" {
  "item_id" decimal(10)
  "item_name" varchar(200)
  "price" decimal(10,2)
  "category" varchar(50)
  "manufacturer" varchar(100)
  "sku" varchar(50)
}

Table "shipments" {
  "ship_id" decimal(10)
  "customer_id" decimal(10)
  "ship_date" date
  "total_amount" decimal(12,2)
}

Table "departments" {
  "dept_id" decimal(10)
  "dept_name" varchar(100)
  "manager_id" decimal(10)
  "status" varchar(20)
}

Table "suppliers" {
  "supp_id" decimal(10)
  "supp_name" varchar(100)
  "contact" varchar(100)
  "ssn" varchar(11)
  "badge_number" varchar(10)
}

Table "customers" {
  "cust_id" decimal(10)
  "cust_name" varchar(100)
  "email" varchar(100)
  "phone" varchar(20) [default: '0123456789']
  "address" varchar(200)
  "status" varchar(20) [default: 'active']
  "reg_date" date
  "last_login" timestamp
}

Table "inventory" {
  "item_id" decimal(10)
  "item_name" varchar(200)
  "price" decimal(10,2)
  "category" varchar(50)
  "sku" varchar(50)
  "weight" decimal(8,2)
  "stock_level" decimal(10)
  "reorder_level" decimal(10)
}

Table "shipments" {
  "ship_id" decimal(10)
  "customer_id" decimal(10)
  "ship_date" date
  "total_amount" decimal(12,2)
  "tracking_number" varchar(50)
  "carrier" varchar(100)
  "priority" decimal(2)
  "notes" varchar(4000)
}

Table "departments" {
  "dept_id" decimal(10)
  "dept_name" varchar(100)
  "manager_id" decimal(10)
  "budget" decimal(12,2)
  "location" varchar(50)
  "established_date" date
}

Table "suppliers" {
  "supp_id" decimal(10)
  "supp_name" varchar(100)
  "contact" varchar(100)
  "ssn" varchar(11)
  "badge_number" varchar(10)
  "credit_limit" decimal(10,2)
}

Table "test_defaults" {
  "col1" decimal
  "col2" varchar(50)
  "col3" date
  "col4" timestamp
  "col5" text
  "col6" RAW(100)
  "col7" float
  "col8" int
  "col9" nvarchar(100)
}

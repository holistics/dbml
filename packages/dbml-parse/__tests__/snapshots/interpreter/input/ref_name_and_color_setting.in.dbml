Table b [headercolor: #aaaaaa] {
  id int
  c_id int
}

Table c {
  id int
  b_id int
}

// Short form
Ref short_ref: b.id < c.id [color: #aabbcc]

// Long form
Ref long_ref {
  c.id < b.c_id [color: #123456]
}

// Color and multi-line note together
Ref noted_ref: b.id - c.b_id [color: #abcdef, note: '''
    First line
      indented line

    Last line
  ''']
